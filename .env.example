# Nuxt/Nitro 网关服务
NITRO_HOST=127.0.0.1
NITRO_PORT=3000

# 旧 xEntry Egg.js 服务地址；源码默认监听 127.0.0.1:9999
XENTRY_BACKEND_URL=http://127.0.0.1:9999

# 腾讯云 Lighthouse 配置
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_LIGHTHOUSE_REGION=ap-shanghai
TENCENT_LIGHTHOUSE_INSTANCE_ID=

# BWH 流量汇报；真实地址和 Webhook 不要提交到 Git
BWH_TRAFFIC_API_URL=
BWH_TRAFFIC_WEBHOOK_URL=
BWH_TRAFFIC_REPORT_TOKEN=
# 保持 false 可避免与 xEntry 现有每日任务重复发送
BWH_TRAFFIC_SCHEDULE_ENABLED=false
