# Nuxt/Nitro 网关服务
NITRO_HOST=127.0.0.1
NITRO_PORT=3000

# 腾讯云 Lighthouse 配置
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_LIGHTHOUSE_REGION=ap-shanghai
TENCENT_LIGHTHOUSE_INSTANCE_ID=

# BWH 流量汇报；真实地址和 Webhook 不要提交到 Git
BWH_TRAFFIC_API_URL=
BWH_TRAFFIC_WEBHOOK_URL=
BWH_TRAFFIC_REPORT_TOKEN=
# 本地/默认保持 false；生产按实际调度需要改为 true
BWH_TRAFFIC_SCHEDULE_ENABLED=false

# 阿里云短信配置；真实凭据和发送令牌只填写在本机/生产环境，不要提交到 Git
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
SMS_SEND_TOKEN=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
# JSON 模板参数；接口会用请求体 msg 覆盖其中的 code 字段
SMS_TEMPLATE_PARAM={"code":""}

# 微信公众号 JS-SDK 分享签名；AppSecret 只保存在服务端环境变量中
WECHAT_OFFICIAL_ACCOUNT_APP_ID=
WECHAT_OFFICIAL_ACCOUNT_APP_SECRET=
# 可发起分享签名的页面 HTTPS 来源，多个来源用逗号分隔，不填路径
WECHAT_JS_SDK_ALLOWED_ORIGINS=
